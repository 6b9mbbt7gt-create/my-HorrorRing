# Next.js（実際に開くURLと合わせる。3002で起動する場合は http://localhost:3002）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Turso / libsql)
# 本番・リモート: libsql://... + TURSO_AUTH_TOKEN
# 開発で重い場合: ローカルSQLiteで高速化（要 npm run migrate:dev でマイグレーション）
# TURSO_DATABASE_URL=file:.data/local.db
# TURSO_AUTH_TOKEN= （空でOK）
TURSO_DATABASE_URL=libsql://your-database-url
TURSO_AUTH_TOKEN=your-auth-token

# betterAuth（NEXT_PUBLIC_APP_URL と同じURLにすること。Googleログインのコールバックに必須）
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth（Cloud Console の「認証済みのリダイレクト URI」に BETTER_AUTH_URL + /api/auth/callback/google を追加）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudflare R2（S3 API エンドポイントはバケット名を含めずホストのみ）
R2_ACCOUNT_ID=926baf15436adaf5e635cc43f5e9c8c9
R2_ENDPOINT=https://926baf15436adaf5e635cc43f5e9c8c9.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=horrorring-media
R2_PUBLIC_URL=https://pub-4c36aa1d64014c16845e58cdfa3b5f5e.r2.dev

# Polar
POLAR_API_KEY=your-polar-api-key
POLAR_ORG_SLUG=horrorring
POLAR_PREMIUM_PRODUCT_ID=prod_...
POLAR_PREMIUM_PRICE_ID=price_...
POLAR_WEBHOOK_SECRET=your-webhook-secret
POLAR_API_BASE_URL=https://api.polar.sh/v1

# Google Maps API (心霊スポット用)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
